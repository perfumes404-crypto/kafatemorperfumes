{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/shop?__route=/"
    },
    {
      "source": "/catalogo",
      "destination": "/api/shop?__route=/catalogo"
    },
    {
      "source": "/perfume/:id",
      "destination": "/api/shop?__route=/perfume/:id"
    },
    {
      "source": "/favoritos",
      "destination": "/api/shop?__route=/favoritos"
    },
    {
      "source": "/comparar",
      "destination": "/api/shop?__route=/comparar"
    },
    {
      "source": "/carrito",
      "destination": "/api/shop?__route=/carrito"
    },
    {
      "source": "/descubrir",
      "destination": "/api/shop?__route=/descubrir"
    },
    {
      "source": "/admin",
      "destination": "/api/shop?__route=/admin"
    },
    {
      "source": "/api/store/:path*",
      "destination": "/api/shop?__route=/api/store/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/shop?__route=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/shop?__route=/robots.txt"
    }
  ],
  "headers": [
    {
      "source": "/media/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "installCommand": "npm ci --include=prod --ignore-scripts"
}
